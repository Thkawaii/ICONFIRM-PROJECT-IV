# ---------------------------------------------------------------------------
# การส่งอีเมลอัตโนมัติ
#
# MAIL_PROVIDER=smtp  → ส่งผ่าน SMTP relay ของบริษัท (ใช้ตัวนี้ตอน deploy)
#   จดหมายวิ่งผ่าน Exchange ของบริษัทและไปโผล่ใน Outlook ของผู้รับตามปกติ
#   รันบน Linux / Docker / Windows ได้หมด ไม่ต้องมี Outlook ติดตั้งบนเครื่องเซิร์ฟเวอร์
#
# MAIL_PROVIDER=outlook → สั่ง Outlook บนเครื่องผ่าน PowerShell
#   ใช้ได้เฉพาะตอนรันบน Windows ที่ล็อกอิน Outlook ค้างไว้เท่านั้น
#   deploy เป็นเซอร์วิสหรือใส่ Docker ไม่ได้ เพราะไม่มี session ของผู้ใช้ให้ Outlook ทำงาน
#   เหมาะกับการทดสอบบนเครื่องตัวเองเท่านั้น
# ---------------------------------------------------------------------------
MAIL_PROVIDER=smtp

MAIL_OUTLOOK_DISPLAY_ONLY=false

MAIL_FROM=theeparat.metheepooriwat@kobelco.com
MAIL_FROM_NAME=I-CONFIRMATION System
MAIL_TIMEOUT_SECONDS=30

MAIL_OUT_DIR=outbox

# ---- SMTP relay ภายในบริษัท (ค่าชุดเดียวกับระบบ Repair ที่ใช้งานอยู่) ----
# relay ตัวนี้ไม่ต้องล็อกอินและไม่เปิด STARTTLS
# เว้น SMTP_USERNAME / SMTP_PASSWORD ว่างไว้ ห้ามใส่
# SMTP_STARTTLS ไม่ต้องตั้งก็ได้ ระบบปิดให้เองเมื่อเป็นพอร์ต 25 แบบไม่ล็อกอิน
SMTP_HOST=10.1.7.204
SMTP_PORT=25
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- ถ้าจะกลับไปใช้ Office 365 แบบล็อกอิน ให้ใช้ชุดนี้แทน ----
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USERNAME=iconfirm@kobelco.com
# SMTP_PASSWORD=


# ---- ปิดใบอนุญาตที่ไม่ได้ต่ออายุอัตโนมัติ ----
# ใบอนุญาตนำเข้า/นำออกไม่ได้ค้างอยู่ตลอดไป — ถ้าผู้ใช้ไม่ต่ออายุและไม่เพิ่มใบใหม่
# เข้าระบบ แปลว่างานของใบนั้นจบแล้ว (รายการถูกยกเลิกหรือขายไม่ได้)
#
# หมดอายุเกินกี่วันจึงถือว่าปิดจบ — ใบนั้นจะหยุดนับอายุและหยุดส่งอีเมลแจ้งเตือน
#   30   = รอ 30 วันหลังหมดอายุแล้วค่อยปิด (ค่าเริ่มต้น)
#   0    = พอหมดอายุก็ปิดเลย ไม่มีระยะผ่อนผัน
#   off  = ไม่ปิดให้อัตโนมัติ (ใบจะค้างเป็น "หมดอายุแล้ว" และถูกแจ้งเตือนไปเรื่อย ๆ)
#
# ระหว่างที่ยังอยู่ในระยะผ่อนผัน ใบจะยังขึ้นว่า "หมดอายุแล้ว" และยังถูกแจ้งเตือนอยู่
# หน้า License Overview จะบอกไว้ในคอลัมน์สถานะว่าเหลืออีกกี่วันจึงจะปิดอัตโนมัติ
#
# เป็นการปิดจบ ไม่ใช่การลบ — ข้อมูลยังอยู่ครบ ดูย้อนหลังได้ทุกใบ
# และถ้าต่ออายุจริงในภายหลัง แค่อัปโหลดใบใหม่เข้ามา ใบนั้นจะกลับมาเดินต่อเอง
LICENSE_AUTO_CLOSE_DAYS=30
